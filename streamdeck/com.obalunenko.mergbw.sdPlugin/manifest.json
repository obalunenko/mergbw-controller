{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "UUID": "com.obalunenko.mergbw",
    "Version": "0.2.0.0",
    "Name": "MeRGBW",
    "Category": "MeRGBW",
    "CategoryIcon": "imgs/plugin",
    "Icon": "imgs/plugin",
    "Author": "Oleg Balunenko",
    "Description": "Local MeRGBW lighting commands / \u041b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u043a\u043e\u043c\u0430\u043d\u0434\u044b MeRGBW",
    "SDKVersion": 3,
    "Nodejs": {
        "Version": "24"
    },
    "Software": {
        "MinimumVersion": "7.1"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "13.5"
        }
    ],
    "CodePath": "bin/plugin.js",
    "PropertyInspectorPath": "ui/index.html",
    "Actions": [
        {
            "UUID": "com.obalunenko.mergbw.on",
            "Name": "On",
            "Tooltip": "Turn power on / \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u044c",
            "Icon": "imgs/on",
            "Controllers": [
                "Keypad"
            ],
            "SupportedInMultiActions": false,
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Image": "imgs/on",
                    "Title": "On",
                    "TitleAlignment": "bottom",
                    "FontSize": 13
                }
            ]
        },
        {
            "UUID": "com.obalunenko.mergbw.off",
            "Name": "Off",
            "Tooltip": "Turn power off / \u0412\u044b\u043a\u043b\u044e\u0447\u0438\u0442\u044c",
            "Icon": "imgs/off",
            "Controllers": [
                "Keypad"
            ],
            "SupportedInMultiActions": false,
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Image": "imgs/off",
                    "Title": "Off",
                    "TitleAlignment": "bottom",
                    "FontSize": 13
                }
            ]
        },
        {
            "UUID": "com.obalunenko.mergbw.color",
            "Name": "Color",
            "Tooltip": "Set RGB and turn power on / \u0426\u0432\u0435\u0442 \u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435",
            "Icon": "imgs/color",
            "Controllers": [
                "Keypad"
            ],
            "SupportedInMultiActions": false,
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Image": "imgs/color",
                    "Title": "FF5000",
                    "TitleAlignment": "bottom",
                    "FontSize": 13
                }
            ]
        },
        {
            "UUID": "com.obalunenko.mergbw.scene",
            "Name": "Scene",
            "Tooltip": "Run a built-in lamp scene / \u0412\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u0430\u044f \u0441\u0446\u0435\u043d\u0430 \u043b\u0430\u043c\u043f\u044b",
            "Icon": "imgs/scene",
            "Controllers": [
                "Keypad"
            ],
            "SupportedInMultiActions": false,
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Image": "imgs/scene",
                    "Title": "Disco",
                    "TitleAlignment": "bottom",
                    "FontSize": 13
                }
            ]
        },
        {
            "UUID": "com.obalunenko.mergbw.brightness",
            "Name": "Brightness",
            "Tooltip": "Set brightness and turn power on; dial press sends Off / \u042f\u0440\u043a\u043e\u0441\u0442\u044c \u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435; \u043d\u0430\u0436\u0430\u0442\u0438\u0435 \u0440\u0443\u0447\u043a\u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 Off",
            "Icon": "imgs/brightness",
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "Encoder": {
                "layout": "$B1"
            },
            "SupportedInMultiActions": false,
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Image": "imgs/brightness",
                    "Title": "50%",
                    "TitleAlignment": "bottom",
                    "FontSize": 13
                }
            ]
        },
        {
            "UUID": "com.obalunenko.mergbw.preset",
            "Name": "Preset",
            "Tooltip": "Apply preset and turn power on / \u041f\u0440\u0435\u0441\u0435\u0442 \u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435",
            "Icon": "imgs/preset",
            "Controllers": [
                "Keypad"
            ],
            "SupportedInMultiActions": false,
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Image": "imgs/preset",
                    "Title": "Preset",
                    "TitleAlignment": "bottom",
                    "FontSize": 13
                }
            ]
        },
        {
            "UUID": "com.obalunenko.mergbw.transition",
            "Name": "Transition",
            "Tooltip": "Smooth RGB and brightness transition / \u041f\u043b\u0430\u0432\u043d\u044b\u0439 \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u0446\u0432\u0435\u0442\u0430 \u0438 \u044f\u0440\u043a\u043e\u0441\u0442\u0438",
            "Icon": "imgs/transition",
            "Controllers": [
                "Keypad"
            ],
            "SupportedInMultiActions": false,
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Image": "imgs/transition",
                    "Title": "Transition",
                    "TitleAlignment": "bottom",
                    "FontSize": 13
                }
            ]
        }
    ]
}
