  "intent": "Natural-looking software lightning effect preset for LT-06",
  "decisions": [
    {
      "decision": "One 0x03 color packet per flash edge; brightness register fixed at flash brightness, background sent as scaled RGB",
      "why": "80 ms gap per packet; two packets per edge would double the shortest flash",
      "rejected": "color+brightness packets per edge"
    },
    {
      "decision": "Flash hold 100-180 ms, inner gap 60-250 ms, intensity 70-100% as controller constants with c.random()",
      "why": "FR-005 keeps timing out of the editor; owner LT-06 run tunes the floor",
      "rejected": "hardware-tag sweep test"
    },
    {
      "decision": "Ranges: pause 500-120000 ms, maxFlashes 1-5, background brightness below flash, durationMs 1000-3600000",
      "why": "mirror candle and breathing rules",
      "rejected": "open-ended ranges"
    },
    {
      "decision": "Shared editor-duration-controls moved out of candle block",
      "why": "candle and lightning both need it",
      "rejected": "second duration input"
    },
    {
      "decision": "Skip the inner gap after the last flash of a strike and check the deadline before each random draw",
      "why": "The next pause follows at once, and no randomness is drawn after the deadline",
      "rejected": "A gap after every flash"
    },
    {
      "decision": "Built US1 inline, dispatched US2 to one worker",
      "why": "US1 owns 4 files, US2 owns 8",
      "rejected": "Dispatching both"
    },
    {
      "decision": "Keep the provisional timing constants and the one-packet scaled background",
      "why": "Owner observation on the LT-06 passed",
      "rejected": "Two-packet color plus brightness fallback"
    },
    {
      "decision": "Accept the unobserved background-brightness-0 check as a known gap",
      "why": "Owner: personal-use MVP",
      "rejected": "Blocking completion on that observation"
    }
  ],
